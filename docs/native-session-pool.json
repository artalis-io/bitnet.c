  "version": 1,
  "goal_status": "active_incomplete",
  "scope": "Reusable native full-request storage with exact-shape pooled leases. This qualifies retained sequential request reuse, bounded retained payload and healthy restart; it does not establish continuous GPU batching or performance parity.",
  "interface": {
    "header": "include/transformer_internal.h",
    "implementation": [
      "src/transformer/trellis_reuse.h",
      "src/transformer/trellis_pool.h"
    ],
    "history_helper": "src/session.c:bn_session_native_history_restart",
    "operations": [
      "request_plan",
      "prepare_request",
      "session_restart",
      "pool_init",
      "pool_acquire",
      "pool_release",
      "pool_info",
      "pool_free"
    ],
    "configuration": "Exact max_tokens, context rounded upward to256 and at least max_tokens, fused window, accumulator mode and logits mode; request geometry within caller ceiling. Maximum16 retained slots.",
    "ownership": "Caller serializes mutations and returns each lease once after generation ends. Pool owns sessions; caller cannot reset/free them. Immutable model, backend and shared cache lifetimes outlive the pool. Copied handles rejected."
  },
  "restart": {
    "boundary": "Only freshly prepared or healthy completed full-forward boundaries. Partial/staged work rejected before GPU calls. Quiesce request work, clear mutable request GPU state, fence completion, then atomically publish empty host native/token history, zero logits and position0 with new request generation.",
    "preserved": "Request allocation, pinned staging, capacities, immutable KV page table, rotary frequencies, converted producer norms and model weights. Existing epoch/generation counters remain monotonic to expire old forward/index/history borrows.",
    "failure": "Any clear/fence/history-publication failure after device work discards the entire backend request. Host history, logits and position are preserved until successful publication. Pool release reclaims a failed restart, counts restart_failures/discarded, and completes valid lease cleanup.",
    "scope": "No GPU allocation, host upload or device readback during healthy restart. Private row-stage upload/workspace allocations retained and overwritten before use; this is not a claim that every retained device byte is privacy-zeroed."
  },
  "budgets": {
    "scope": "All retained idle AND leased request planned payload charged independently in device/host/pinned dimensions. Shared model/expert/row caches, codec workspaces, bounded pool metadata and allocator/driver overhead remain separate; not total physical VRAM/RSS.",
    "admission": "Reuse exact idle shape. Otherwise test feasibility against live slots before any eviction; BUSY leaves all live and idle state untouched. Reclaim idle largest-device entries as necessary, never live leases. Permanent oversize rejected before allocation. Preparation failure cleans the candidate and leaves accurate accounting.",
    "sample_two_shapes": {
      "prompt_tokens": [
        2050,
        1026
      ],
      "prefill_rows": [
        2048,
        1026
      ],
      "prepared_context": [
        2304,
