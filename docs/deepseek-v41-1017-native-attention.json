{
  "status": "Qualified native CUDA F16 latent-attention primitive for prefill and split decode. Request/controller integration, output projections/Engram, full model admission and vLLM parity remain open.",
  "architecture": "DeepseekV41ForCausalLM",
  "apis": [
    "BnGPUF16LatentAttentionWorkspace",
