{
  "version": 1,
  "goal_status": "active_incomplete",
  "scope": "Implemented resumable explicit native text request orchestration, with source-exact caller-serialized interleaving of two active sessions on one shared model. Not a production serving scheduler or multi-request GPU batch.",
  "api": {
    "header": "include/generate.h",
    "implementation": "src/generate_native_text.h",
    "type": "BnGenerateNativeTextRequest",
    "functions": [
      "bn_generate_native_text_request_init",
      "bn_generate_native_text_request_step",
      "bn_generate_native_text_request_cancel",
      "bn_generate_native_text_request_free"
    ],
    "semantics": "Caller-owned zeroed struct, no copying, disjoint per-request workspace and independent prepared session. Init encodes once with no forward. Each step attempts at most one backend forward; prefill commits at most the configured chunk, decode at most one ID. BUSY yields with staged input/admission/output state preserved. Both committed and prediction-first contracts supported.",
    "terminal": "DONE flushes once; subsequent terminal steps do nothing. ERROR/CANCELLED do not flush. Cancellation/free do no backend cleanup: caller resets/reprepares or frees the session before reuse, reclaiming any staged/partially executed backend work through existing ownership. Reentry is rejected; caller serializes all backend access.",
    "allocation": "No orchestration allocations. Inline request state and caller workspace; backend placement allocations and user callbacks retain their existing separate budgets.",
    "compatibility": "Both existing blocking APIs now drive the same request state machine and retry BUSY as before. Last prediction remains unforwarded; committed path forwards before publication. Prefill never admits GPU expert entries. No kernel, model architecture, quantization, placement policy or default CLI changes."
  },
